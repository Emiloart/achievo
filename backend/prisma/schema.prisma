model LegacyGoalApproval {
  id          String   @id @default(uuid())
  chainId     Int
  contractAddress String
  goalId      String
  approver    String
  approvals   Int
  txHash      String
  blockNumber Int
  createdAt   DateTime
  eventId     String   @unique
  removed     Boolean  @default(false)

  @@index([goalId])
  @@index([approver])
}

model UsernameOwnership {
  id            String   @id @default(uuid())
  chainId       Int
  handleHash    String
  normalized    String
  ownerAddress  String
  updatedAtBlock Int?
  txHash        String?
