{
  "name": "achievo-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "cross-env TS_NODE_TRANSPILE_ONLY=1 ts-node-dev --respawn --pretty --ignore-watch node_modules src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test:unit": "jest -c jest.config.cjs --testPathPattern=unit",
    "test:integration": "cross-env NODE_ENV=test prisma migrate deploy && cross-env NODE_ENV=test jest -c jest.config.cjs --testPathPattern=integration --runInBand",
    "test:integration:db": "node scripts/test-integration-db.cjs",
    "test:e2e": "jest -c test/e2e/jest.e2e.config.cjs --runInBand",
    "e2e:setup": "node test/e2e/run-setup.cjs",
    "e2e:teardown": "node test/e2e/run-teardown.cjs",
    "test": "npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-fastify": "^10.0.0",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^5.1.2",
    "@prisma/client": "^5.20.0",
    "argon2": "^0.31.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "fastify": "^4.26.2",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.15.0",
    "prisma": "^5.20.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.1.13",
    "swagger-ui-express": "^5.0.1",
    "viem": "^2.21.25"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.30",
    "@types/pdfkit": "^0.13.4",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
